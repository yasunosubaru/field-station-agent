{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://fsa.local/schema/run-link.schema.json",
  "title": "run_link 四表与唯一耦合点（E2）",
  "description": "task / thread / agent / work_order 各写各的；只有 run_link 同时带 task_id 与另一本账的 external_id。",
  "type": "object",
  "required": ["task", "thread", "agent", "work_order", "run_link"],
  "properties": {
    "task": { "$ref": "#/definitions/task" },
    "thread": { "$ref": "#/definitions/thread" },
    "agent": { "$ref": "#/definitions/agent" },
    "work_order": { "$ref": "#/definitions/work_order" },
    "run_link": {
      "type": "array",
      "items": { "$ref": "#/definitions/run_link" }
    }
  },
  "additionalProperties": false,
  "definitions": {
    "task": {
      "type": "object",
      "required": [
        "task_id",
        "root_task_id",
        "kind",
        "title",
        "payload",
        "status",
        "priority",
        "attempts",
        "max_attempts",
        "available_at",
        "created_at",
        "updated_at"
      ],
      "properties": {
        "task_id": { "type": "string", "pattern": "^t-[0-9a-f]{24}$" },
        "parent_task_id": { "type": ["string", "null"] },
        "root_task_id": { "type": "string" },
        "bot_id": { "type": ["string", "null"] },
        "step_id": { "type": ["string", "null"] },
        "kind": { "type": "string", "enum": ["chat", "bot", "pipeline", "workflow"] },
        "title": { "type": "string" },
        "payload": { "type": "object" },
        "status": {
          "type": "string",
          "enum": [
            "pending",
            "running",
            "waiting_approval",
            "waiting_operator",
            "done",
            "failed",
            "dead",
            "cancelled"
          ]
        },
        "priority": { "type": "integer" },
        "attempts": { "type": "integer", "minimum": 0 },
        "max_attempts": { "type": "integer", "minimum": 1 },
        "available_at": { "type": "string", "format": "date-time" },
        "lease_owner": { "type": ["string", "null"] },
        "lease_expires_at": { "type": ["string", "null"], "format": "date-time" },
        "result": { "type": ["object", "null"] },
        "last_error": { "type": ["string", "null"] },
        "created_at": { "type": "string", "format": "date-time" },
        "updated_at": { "type": "string", "format": "date-time" }
      },
      "additionalProperties": false
    },
    "thread": {
      "type": "object",
      "required": [
        "thread_id",
        "runtime",
        "external_thread_id",
        "checkpointer_ns",
        "trace_path",
        "message_count",
        "last_event_seq",
        "status",
        "created_at"
      ],
      "properties": {
        "thread_id": { "type": "string", "pattern": "^th-[0-9a-f]{24}$" },
        "runtime": { "type": "string", "enum": ["opencode", "claude"] },
        "external_thread_id": { "type": "string", "minLength": 1 },
        "checkpointer_ns": { "type": "string", "minLength": 1 },
        "trace_path": { "type": "string", "minLength": 1 },
        "message_count": { "type": "integer", "minimum": 0 },
        "last_event_seq": { "type": "integer", "minimum": 0 },
        "status": { "type": "string", "enum": ["open", "idle", "closed", "broken"] },
        "created_at": { "type": "string", "format": "date-time" },
        "closed_at": { "type": ["string", "null"], "format": "date-time" }
      },
      "additionalProperties": false
    },
    "agent": {
      "type": "object",
      "required": [
        "agent_id",
        "name",
        "kind",
        "spec_path",
        "spec_sha256",
        "runtime",
        "model",
        "memory_namespace",
        "allowed_tools",
        "status",
        "created_at"
      ],
      "properties": {
        "agent_id": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "kind": { "type": "string", "enum": ["supervisor", "worker", "runtime"] },
        "spec_path": { "type": "string", "minLength": 1 },
        "spec_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "runtime": { "type": "string", "enum": ["opencode", "claude"] },
        "model": { "type": "string", "minLength": 1 },
        "memory_namespace": { "type": "string", "minLength": 1 },
        "parent_agent_id": { "type": ["string", "null"] },
        "allowed_tools": {
          "type": "array",
          "items": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" }
        },
        "status": { "type": "string", "enum": ["active", "paused", "retired"] },
        "created_at": { "type": "string", "format": "date-time" }
      },
      "additionalProperties": false
    },
    "work_order": {
      "type": "object",
      "required": [
        "work_order_id",
        "station_id",
        "title",
        "priority",
        "risk",
        "status",
        "evidence_call_ids",
        "created_by",
        "created_at"
      ],
      "properties": {
        "work_order_id": { "type": "string", "pattern": "^wo-[0-9a-f]{24}$" },
        "station_id": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "priority": { "type": "string", "enum": ["P0", "P1", "P2", "P3"] },
        "risk": { "type": "string", "enum": ["low", "medium", "high"] },
        "status": {
          "type": "string",
          "enum": [
            "open",
            "acknowledged",
            "in_progress",
            "waiting_approval",
            "done",
            "cancelled",
            "rejected"
          ]
        },
        "action": { "type": ["string", "null"] },
        "description": { "type": ["string", "null"] },
        "evidence_call_ids": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "created_by": { "type": "string", "minLength": 1 },
        "approved_by": { "type": ["string", "null"] },
        "created_at": { "type": "string", "format": "date-time" },
        "closed_at": { "type": ["string", "null"], "format": "date-time" },
        "artifact_sha256": { "type": ["string", "null"], "pattern": "^[0-9a-f]{64}$" }
      },
      "additionalProperties": false
    },
    "run_link": {
      "type": "object",
      "required": [
        "link_id",
        "task_id",
        "kind",
        "provider",
        "external_id",
        "status",
        "detail",
        "created_at",
        "updated_at"
      ],
      "properties": {
        "link_id": { "type": "string", "pattern": "^r-[0-9a-f]{24}$" },
        "task_id": { "type": "string", "pattern": "^t-[0-9a-f]{24}$" },
        "kind": { "type": "string", "enum": ["thread", "agent", "work_order"] },
        "provider": {
          "type": "string",
          "enum": ["dbos", "langgraph", "letta", "ledger", "runtime"]
        },
        "external_id": { "type": "string", "minLength": 1 },
        "status": { "type": "string", "enum": ["linked", "unlinked", "stale"] },
        "detail": { "type": "object" },
        "created_at": { "type": "string", "format": "date-time" },
        "updated_at": { "type": "string", "format": "date-time" }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": { "properties": { "kind": { "const": "thread" } }, "required": ["kind"] },
          "then": {
            "properties": {
              "provider": { "enum": ["dbos", "langgraph", "runtime"] },
              "external_id": { "pattern": "^th-[0-9a-f]{24}$" }
            }
          }
        },
        {
          "if": { "properties": { "kind": { "const": "work_order" } }, "required": ["kind"] },
          "then": {
            "properties": {
              "provider": { "enum": ["ledger"] },
              "external_id": { "pattern": "^wo-[0-9a-f]{24}$" }
            }
          }
        },
        {
          "if": { "properties": { "kind": { "const": "agent" } }, "required": ["kind"] },
          "then": {
            "properties": {
              "provider": { "enum": ["letta"] }
            }
          }
        }
      ]
    }
  }
}
