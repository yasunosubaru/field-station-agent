<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="DevChatApp.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    RequestedTheme="Dark">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <!-- 主题色板。暗色为默认（应用 RequestedTheme="Dark"），
                 浅色一并给出，用户在系统里切浅色也不会崩。 -->
            <ResourceDictionary.ThemeDictionaries>

                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="AppBackgroundBrush" Color="#141413" />
                    <SolidColorBrush x:Key="PanelBrush" Color="#1C1C1A" />
                    <SolidColorBrush x:Key="LineBrush" Color="#2E2D2A" />
                    <SolidColorBrush x:Key="LineSoftBrush" Color="#242320" />
                    <SolidColorBrush x:Key="InkBrush" Color="#E9E7E3" />
                    <SolidColorBrush x:Key="Ink2Brush" Color="#A8A5A0" />
                    <SolidColorBrush x:Key="DimBrush" Color="#78756F" />
                    <SolidColorBrush x:Key="AccentBrush" Color="#D97757" />
                    <SolidColorBrush x:Key="OkBrush" Color="#63A855" />
                    <SolidColorBrush x:Key="BadBrush" Color="#D1685A" />
                    <SolidColorBrush x:Key="CodeBgBrush" Color="#26251F" />
                    <SolidColorBrush x:Key="HoverBrush" Color="#232220" />
                    <SolidColorBrush x:Key="SelBrush" Color="#2B2A26" />
                    <SolidColorBrush x:Key="TagBgBrush" Color="#2E2D2A" />

                    <SolidColorBrush x:Key="MemberA" Color="#6FA8DC" />
                    <SolidColorBrush x:Key="MemberB" Color="#7FBF6A" />
                    <SolidColorBrush x:Key="MemberC" Color="#C08BD0" />
                    <SolidColorBrush x:Key="MemberD" Color="#E0A94F" />
                    <SolidColorBrush x:Key="MemberUser" Color="#E8896A" />
                </ResourceDictionary>

                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="AppBackgroundBrush" Color="#FBFBFA" />
                    <SolidColorBrush x:Key="PanelBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="LineBrush" Color="#E7E6E3" />
                    <SolidColorBrush x:Key="LineSoftBrush" Color="#F0EEE9" />
                    <SolidColorBrush x:Key="InkBrush" Color="#1C1B19" />
                    <SolidColorBrush x:Key="Ink2Brush" Color="#5D5A55" />
                    <SolidColorBrush x:Key="DimBrush" Color="#94908A" />
                    <SolidColorBrush x:Key="AccentBrush" Color="#C2603A" />
                    <SolidColorBrush x:Key="OkBrush" Color="#4A8A3F" />
                    <SolidColorBrush x:Key="BadBrush" Color="#B04A3A" />
                    <SolidColorBrush x:Key="CodeBgBrush" Color="#F0EEE9" />
                    <SolidColorBrush x:Key="HoverBrush" Color="#F4F2EF" />
                    <SolidColorBrush x:Key="SelBrush" Color="#F0EEE9" />
                    <SolidColorBrush x:Key="TagBgBrush" Color="#F0EEE9" />

                    <SolidColorBrush x:Key="MemberA" Color="#3A6EA5" />
                    <SolidColorBrush x:Key="MemberB" Color="#4A8A3F" />
                    <SolidColorBrush x:Key="MemberC" Color="#9A5AA8" />
                    <SolidColorBrush x:Key="MemberD" Color="#B8791A" />
                    <SolidColorBrush x:Key="MemberUser" Color="#C2603A" />
                </ResourceDictionary>

                <ResourceDictionary x:Key="HighContrast">
                    <SolidColorBrush x:Key="AppBackgroundBrush" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="PanelBrush" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="LineBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="LineSoftBrush" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="InkBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="Ink2Brush" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="DimBrush" Color="{ThemeResource SystemColorGrayTextColor}" />
                    <SolidColorBrush x:Key="AccentBrush" Color="{ThemeResource SystemColorHighlightColor}" />
                    <SolidColorBrush x:Key="OkBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="BadBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="CodeBgBrush" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="HoverBrush" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="SelBrush" Color="{ThemeResource SystemColorHighlightColor}" />
                    <SolidColorBrush x:Key="TagBgBrush" Color="{ThemeResource SystemColorWindowColor}" />

                    <SolidColorBrush x:Key="MemberA" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="MemberB" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="MemberC" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="MemberD" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="MemberUser" Color="{ThemeResource SystemColorWindowTextColor}" />
                </ResourceDictionary>

            </ResourceDictionary.ThemeDictionaries>

            <!-- 输入框/按钮：暗色下不要系统默认的高亮白底 -->
            <Style x:Key="ChatTextBoxStyle" TargetType="TextBox">
                <Setter Property="Background" Value="{ThemeResource PanelBrush}" />
                <Setter Property="Foreground" Value="{ThemeResource InkBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource LineBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="5" />
                <Setter Property="Padding" Value="10,8" />
                <Setter Property="SelectionHighlightColor" Value="{ThemeResource AccentBrush}" />
            </Style>

            <Style x:Key="ChatButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="{ThemeResource PanelBrush}" />
                <Setter Property="Foreground" Value="{ThemeResource InkBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource LineBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="5" />
            </Style>

            <Style x:Key="SendButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="{ThemeResource AccentBrush}" />
                <Setter Property="Foreground" Value="#FFFFFF" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="CornerRadius" Value="5" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </Style>

            <Style x:Key="ChatComboBoxStyle" TargetType="ComboBox">
                <Setter Property="Background" Value="{ThemeResource PanelBrush}" />
                <Setter Property="Foreground" Value="{ThemeResource InkBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource LineBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="5" />
            </Style>

        </ResourceDictionary>
    </Application.Resources>
</Application>
