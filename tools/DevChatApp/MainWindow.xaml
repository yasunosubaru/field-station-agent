<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="DevChatApp.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Background="{ThemeResource AppBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ===== 顶栏 ===== -->
        <Border Grid.Row="0" Padding="14,0" Height="42"
                Background="{ThemeResource PanelBrush}"
                BorderBrush="{ThemeResource LineBrush}" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Ellipse x:Name="StatusDot" Grid.Column="0" Width="7" Height="7"
                         Fill="{ThemeResource OkBrush}" Margin="0,0,9,0"
                         VerticalAlignment="Center" />

                <TextBlock Grid.Column="1" Text="开发群聊" FontSize="14" FontWeight="SemiBold"
                           Foreground="{ThemeResource InkBrush}" VerticalAlignment="Center" />

                <TextBlock x:Name="StatusText" Grid.Column="2" Text="连接中"
                           FontSize="11" Foreground="{ThemeResource DimBrush}"
                           VerticalAlignment="Center" Margin="12,0,12,0"
                           TextTrimming="CharacterEllipsis" />

                <Button x:Name="SettingsButton" Grid.Column="3" Content="设置"
                        Style="{StaticResource ChatButtonStyle}"
                        FontSize="12" Padding="12,4" VerticalAlignment="Center"
                        Click="OnSettingsClick" />
            </Grid>
        </Border>

        <!-- ===== 主体：侧栏 + 消息 ===== -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="140" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- 侧栏 -->
            <Border Grid.Column="0" Background="{ThemeResource PanelBrush}"
                    BorderBrush="{ThemeResource LineBrush}" BorderThickness="0,0,1,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollMode="Disabled"
                              HorizontalScrollBarVisibility="Disabled"
                              Padding="5,8,5,8">
                    <StackPanel x:Name="MemberList" Spacing="1" Width="128" />
                </ScrollViewer>
            </Border>

            <!-- 消息流 -->
            <ScrollViewer x:Name="FeedScroll" Grid.Column="1"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Padding="16,12">
                <StackPanel x:Name="FeedPanel" Spacing="13" />
            </ScrollViewer>
        </Grid>

        <!-- ===== 输入区 ===== -->
        <Border Grid.Row="2" Padding="12,9"
                Background="{ThemeResource PanelBrush}"
                BorderBrush="{ThemeResource LineBrush}" BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <ComboBox x:Name="WhoBox" Grid.Column="0" MinWidth="130" Margin="0,0,8,0"
                          Style="{StaticResource ChatComboBoxStyle}"
                          VerticalAlignment="Bottom" SelectionChanged="OnWhoChanged" />

                <TextBox x:Name="InputBox" Grid.Column="1"
                         Style="{StaticResource ChatTextBoxStyle}"
                         PlaceholderText="说点什么…（Ctrl+Enter 发送）"
                         AcceptsReturn="True" TextWrapping="Wrap"
                         MinHeight="42" MaxHeight="132"
                         VerticalAlignment="Bottom"
                         KeyDown="OnInputKeyDown" />

                <Button x:Name="SendButton" Grid.Column="2" Content="发送" Margin="8,0,0,0"
                        MinWidth="78" Height="42" VerticalAlignment="Bottom"
                        Style="{StaticResource SendButtonStyle}"
                        Click="OnSendClick" />
            </Grid>
        </Border>
    </Grid>
</Window>
